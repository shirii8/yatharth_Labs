enum StaffRole {
  FRONT_DESK
  LAB_ADMIN
}

/// Lab staff who sign in with email and password. Patients never have passwords.
model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  /// bcrypt hash. The password itself is never stored.
  passwordHash String
  role         StaffRole
  active       Boolean   @default(true)
  /// Wrong passwords in a row, reset on success. Five locks the account for 15 minutes.
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
}
