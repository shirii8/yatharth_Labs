# Copy this file to .env and fill in values locally.
# Never commit .env. Names only here, no real values.

# Database (PostgreSQL)
# Pooled connection URL, used by the app at runtime (Supabase pooler in production).
DATABASE_URL=
# Direct connection URL, used only by Prisma migrations.
DIRECT_URL=

# Secrets (each one a long random string, for example: openssl rand -base64 48)
# Signs the session cookie.
SESSION_SECRET=
# Keyed hash (HMAC) for phone numbers, so they can be looked up without being stored in plain text.
PHONE_HASH_KEY=
# Encrypts the full phone number (AES-256-GCM), needed to send SMS. 32 bytes, base64.
PHONE_ENC_KEY=
# Keyed hash for OTP codes and report link tokens.
TOKEN_HASH_KEY=

# Public app address, used to build report links in SMS.
APP_BASE_URL=http://localhost:3000

# Branding shown to patients
NEXT_PUBLIC_BRAND_NAME=Yatharth
NEXT_PUBLIC_LAB_NAME=
NEXT_PUBLIC_LAB_PHONE=

# SMS provider: "mock" logs messages instead of sending them.
SMS_PROVIDER=mock
SMS_API_KEY=

# AI for summary wording and Telugu and Hindi drafts. Rules still decide every flag.
# With no key set, patients see the plain rule line and the full report link instead.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=
# Seconds to wait for the AI before falling back to the plain rule line.
AI_TIMEOUT_SECONDS=8

# Demo mode: allows one fixed OTP for the demo patient number only. Never enable in a real deployment.
DEMO_MODE=false
DEMO_OTP=
# Password for the two demo staff logins created by the seed. 12 characters or more.
DEMO_STAFF_PASSWORD=

# Local tests only: a throwaway database whose name ends in _test. Reset on every run.
TEST_DATABASE_URL=
